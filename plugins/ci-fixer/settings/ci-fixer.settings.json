{
  "env": {
    "CI_FIXER": "1",
    "CI_MAX_ITER": "5"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push -u origin *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)"
    ],
    "deny": [
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(**/test/**)",
      "Write(**/test/**)",
      "Edit(**/tests/**)",
      "Write(**/tests/**)",
      "Edit(**/__tests__/**)",
      "Write(**/__tests__/**)",
      "Edit(**/spec/**)",
      "Write(**/spec/**)",
      "Edit(**/e2e/**)",
      "Write(**/e2e/**)",
      "Edit(**/*.test.*)",
      "Write(**/*.test.*)",
      "Edit(**/*.spec.*)",
      "Write(**/*.spec.*)",
      "Edit(**/test_*.py)",
      "Write(**/test_*.py)",
      "Edit(**/*_test.py)",
      "Write(**/*_test.py)",
      "Edit(**/conftest.py)",
      "Write(**/conftest.py)",
      "Edit(**/*_test.go)",
      "Write(**/*_test.go)",
      "Edit(**/*Test.java)",
      "Write(**/*Test.java)",
      "Edit(**/*Tests.java)",
      "Write(**/*Tests.java)",
      "Edit(**/*Test.kt)",
      "Write(**/*Test.kt)",
      "Edit(**/*Tests.cs)",
      "Write(**/*Tests.cs)",
      "Edit(**/*_spec.rb)",
      "Write(**/*_spec.rb)",
      "Edit(**/__snapshots__/**)",
      "Write(**/__snapshots__/**)",
      "Edit(**/*.snap)",
      "Write(**/*.snap)",
      "Edit(**/fixtures/**)",
      "Write(**/fixtures/**)",
      "Edit(**/testdata/**)",
      "Write(**/testdata/**)",
      "Edit(**/jest.config.*)",
      "Write(**/jest.config.*)",
      "Edit(**/vitest.config.*)",
      "Write(**/vitest.config.*)",
      "Edit(**/playwright.config.*)",
      "Write(**/playwright.config.*)",
      "Edit(**/pytest.ini)",
      "Write(**/pytest.ini)",
      "Edit(**/tox.ini)",
      "Write(**/tox.ini)",
      "Edit(**/.coveragerc)",
      "Write(**/.coveragerc)",
      "Edit(**/codecov.yml)",
      "Write(**/codecov.yml)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * develop*)",
      "Bash(git push * release/*)",
      "Bash(git push * *:main*)",
      "Bash(git push * *:master*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)"
    ]
  }
}
