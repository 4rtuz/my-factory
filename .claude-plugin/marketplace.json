{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "my-factory",
  "description": "Directorio de herramientas de Claude Code para proyectos y repositorios.",
  "owner": {
    "name": "MyFactory",
    "url": "https://github.com/4rtuz/my-factory"
  },
  "plugins": [
    {
      "name": "critic-reviewer",
      "source": "./plugins/critic-reviewer",
      "category": "productivity"
    },
    {
      "name": "verification-plan",
      "source": "./plugins/verification-plan",
      "category": "development"
    },
    {
      "name": "threejs-skills",
      "source": "./tools/threejs-skills",
      "description": "Skills de Three.js: fundamentos, geometria, materiales, shaders, luces, texturas, animacion, interaccion, loaders y postprocesado.",
      "category": "development",
      "strict": false
    },
    {
      "name": "mattpocock-skills",
      "source": "./tools/mattpocock-skills",
      "category": "development"
    },
    {
      "name": "ponytail",
      "source": "./tools/ponytail",
      "category": "productivity"
    },
    {
      "name": "taste-skill",
      "source": "./tools/taste-skill",
      "category": "design"
    },
    {
      "name": "fastapi-skill",
      "source": "./tools/fastapi-skill",
      "category": "development"
    },
    {
      "name": "find-skills",
      "source": "./tools/find-skills",
      "description": "Descubre e instala agent skills del registro abierto (npx skills) cuando pides una capacidad que no tienes.",
      "category": "productivity",
      "strict": false
    }
  ]
}
