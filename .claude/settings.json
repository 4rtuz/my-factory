{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-marketplace-drift.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-marketplace-drift.mjs",
            "if": "Bash(git submodule *)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
